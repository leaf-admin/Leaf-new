rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() &&
             request.auth.token.admin == true &&
             request.auth.token.role in ['admin', 'super-admin'];
    }

    // ============================================
    // REGRAS PARA ADMINISTRADORES DO DASHBOARD
    // ============================================
    
    // Coleção adminUsers - Gestão de administradores
    match /adminUsers/{userId} {
      // O dashboard pode consultar a própria identidade administrativa. Toda
      // mutação passa pela Leaf API/Admin SDK para impedir autoelevação.
      allow read: if isSelf(userId) || isAdmin();
      allow create, update, delete: if false;
    }
    
    // ============================================
    // REGRAS PARA DADOS DE USUÁRIOS
    // ============================================
    
    match /users/{userId} {
      // Leitura: apenas admins ou o próprio usuário
      allow read: if request.auth != null && 
                     (request.auth.uid == userId || 
                      (request.auth.token.admin == true && 
                       request.auth.token.role in ['admin', 'super-admin']));
      
      // Escrita: apenas admins
      allow write: if request.auth != null && 
                     request.auth.token.admin == true && 
                     request.auth.token.role in ['admin', 'super-admin'];
    }
    
    // ============================================
    // REGRAS PARA CORRIDAS/VIAGENS
    // ============================================
    
    match /rides/{rideId} {
      allow read: if request.auth != null && 
                     request.auth.token.admin == true && 
                     request.auth.token.role in ['admin', 'super-admin'];
      
      allow write: if request.auth != null && 
                     request.auth.token.admin == true && 
                     request.auth.token.role in ['admin', 'super-admin'];
    }
    
    match /trips/{tripId} {
      allow read: if request.auth != null && 
                     request.auth.token.admin == true && 
                     request.auth.token.role in ['admin', 'super-admin'];
      
      allow write: if request.auth != null && 
                     request.auth.token.admin == true && 
                     request.auth.token.role in ['admin', 'super-admin'];
    }
    
    // ============================================
    // REGRAS PARA MOTORISTAS
    // ============================================
    
    // ============================================
    // REGRAS PARA VEÍCULOS
    // ============================================

    match /vehicles/{vehicleId} {
      // Cadastro, consulta, seleção e exclusão usam /api/account/vehicles.
      // Aprovação e campos operacionais permanecem backend-governados.
      allow read, write: if false;
    }

    match /drivers/{driverId} {
      allow read: if request.auth != null &&
                     request.auth.token.admin == true &&
                     request.auth.token.role in ['admin', 'super-admin'];

      allow write: if request.auth != null &&
                     request.auth.token.admin == true &&
                     request.auth.token.role in ['admin', 'super-admin'];
    }

    match /driver_status/{driverId} {
      allow read: if request.auth != null &&
                     request.auth.token.admin == true &&
                     request.auth.token.role in ['admin', 'super-admin'];

      allow write: if request.auth != null &&
                     request.auth.token.admin == true &&
                     request.auth.token.role in ['admin', 'super-admin'];
    }
    
    // ============================================
    // REGRAS PARA PAGAMENTOS
    // ============================================
    
    match /ride_payments/{paymentId} {
      allow read: if request.auth != null && 
                     request.auth.token.admin == true && 
                     request.auth.token.role in ['admin', 'super-admin'];
      
      allow write: if request.auth != null && 
                     request.auth.token.admin == true && 
                     request.auth.token.role == 'super-admin';
    }

    match /payment_holdings/{rideId} {
      allow read: if request.auth != null &&
                     request.auth.token.admin == true &&
                     request.auth.token.role in ['admin', 'super-admin'];
      allow write: if request.auth != null &&
                     request.auth.token.admin == true &&
                     request.auth.token.role == 'super-admin';
    }

    match /payment_history/{eventId} {
      allow read: if request.auth != null &&
                     request.auth.token.admin == true &&
                     request.auth.token.role in ['admin', 'super-admin'];
      allow write: if request.auth != null &&
                     request.auth.token.admin == true &&
                     request.auth.token.role == 'super-admin';
    }

    match /payment_distributions/{rideId} {
      allow read: if request.auth != null &&
                     request.auth.token.admin == true &&
                     request.auth.token.role in ['admin', 'super-admin'];
      allow write: if request.auth != null &&
                     request.auth.token.admin == true &&
                     request.auth.token.role == 'super-admin';
    }

    match /driver_balances/{driverId} {
      allow read: if request.auth != null &&
                     (request.auth.uid == driverId ||
                      (request.auth.token.admin == true &&
                       request.auth.token.role in ['admin', 'super-admin']));
      allow write: if request.auth != null &&
                     request.auth.token.admin == true &&
                     request.auth.token.role in ['admin', 'super-admin'];
      match /transactions/{txId} {
        allow read: if request.auth != null &&
                       (request.auth.uid == driverId ||
                        (request.auth.token.admin == true &&
                         request.auth.token.role in ['admin', 'super-admin']));
        allow write: if request.auth != null &&
                       request.auth.token.admin == true &&
                       request.auth.token.role in ['admin', 'super-admin'];
      }
    }

    match /driver_withdrawals/{withdrawalId} {
      allow read: if isSignedIn() &&
                     (request.auth.uid == resource.data.driverId || isAdmin());
      // Saldo, ledger, tarifas, KYC e idempotência só podem ser validados pela API.
      allow create, update, delete: if false;
    }
    
    // ============================================
    // REGRAS PARA PROMOÇÕES
    // ============================================
    
    match /promotions/{promotionId} {
      allow read: if request.auth != null && 
                     request.auth.token.admin == true && 
                     request.auth.token.role in ['admin', 'super-admin'];
      
      allow write: if request.auth != null && 
                     request.auth.token.admin == true && 
                     request.auth.token.role in ['admin', 'super-admin'];
    }
    
    // ============================================
    // REGRAS PARA SUPORTE/TICKETS
    // ============================================
    
    match /support_tickets/{ticketId} {
      allow read: if isSignedIn() &&
                     (request.auth.uid == resource.data.userId || isAdmin());
      // Criação, mensagens e alterações passam pela Leaf Support API.
      allow create, update, delete: if false;
    }
    
    // ============================================
    // REGRAS PARA WAITLIST
    // ============================================
    
    match /waitlist/{entryId} {
      allow read: if request.auth != null && 
                     request.auth.token.admin == true && 
                     request.auth.token.role in ['admin', 'super-admin'];
      
      allow write: if request.auth != null && 
                     request.auth.token.admin == true && 
                     request.auth.token.role in ['admin', 'super-admin'];
    }
    
    // ============================================
    // REGRAS PARA MÉTRICAS E ESTATÍSTICAS
    // ============================================
    
    match /metrics/{metricId} {
      allow read: if request.auth != null && 
                     request.auth.token.admin == true && 
                     request.auth.token.role in ['admin', 'super-admin'];
      
      allow write: if request.auth != null && 
                     request.auth.token.admin == true && 
                     request.auth.token.role == 'super-admin';
    }
    
    // ============================================
    // REGRAS PARA LOCALIZAÇÕES
    // ============================================
    
    match /user_locations/{userId} {
      allow read: if request.auth != null && 
                     request.auth.token.admin == true && 
                     request.auth.token.role in ['admin', 'super-admin'];
      
      allow write: if false; // Apenas backend pode escrever
    }
    
    // ============================================
    // REGRAS PARA DADOS DE VIAGEM (TRIP_DATA)
    // ============================================
    match /trip_data/{tripId} {
      // O lifecycle Robotaxi usa Socket/Redis e persistência backend no Firestore.
      allow read, write: if false;
    }
    
    // ============================================
    // REGRA PADRÃO: NEGAR TUDO
    // ============================================
    // Qualquer coleção não especificada acima será negada por padrão
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
