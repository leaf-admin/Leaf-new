    "test:e2e:adb": "node e2e-adb/run-leaf-e2e-adb.cjs",
    "build:android:export": "bash scripts/export-android-bytecode.sh",
    "env:local:setup:mac": "bash scripts/setup-local-build-macos.sh",
    "env:local:doctor": "bash scripts/local-build-doctor.sh",
    "prebuild:local": "npx expo prebuild",
    "build:local:android:debug": "bash scripts/build-local-android.sh debug",
    "build:local:android:release": "bash scripts/build-local-android.sh release",
    "build:local:android:aab": "bash scripts/build-local-android.sh aab",
    "build:local:ios:simulator": "bash scripts/build-local-ios.sh simulator",
    "build:local:ios:archive": "bash scripts/build-local-ios.sh archive",
    "build:local:ios:ipa": "bash scripts/export-local-ios-ipa.sh",
    "screenshots:adb": "bash scripts/capture-store-screenshots-adb.sh",
    "qa:run": "bash scripts/qa-run.sh",
    "qa:runtime:endpoints": "bash scripts/check-runtime-endpoints.sh",
    "qa:permissions": "bash scripts/check-permissions-hardening.sh",
    "qa:phase6:manual": "bash scripts/phase6-manual-evidence.sh",
    "qa:phase6:cross": "bash scripts/phase6-cross-platform-evidence.sh",
    "qa:asserts": "bash scripts/qa-asserts.sh"
