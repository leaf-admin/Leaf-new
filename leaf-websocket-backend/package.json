{
  "name": "leaf-websocket-backend",
  "version": "1.0.0",
  "description": "WebSocket backend para LEAF com Redis e Firebase",
  "main": "server.js",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "worker:queue": "node workers/queue-worker-process.js",
    "test": "node ../scripts/tests/run-with-profile.cjs backend-test \"npx jest --config config/jest.unit.config.js && npx jest --config config/jest.integration.config.js\"",
    "test:all": "node ../scripts/tests/run-with-profile.cjs backend-all \"npx jest --config config/jest.unit.config.js && npx jest --config config/jest.integration.config.js && npx jest --config config/jest.config.js\"",
    "test:unit": "node ../scripts/tests/run-with-profile.cjs backend-unit \"npx jest --config config/jest.unit.config.js\"",
    "test:unit:watch": "node ../scripts/tests/run-with-profile.cjs backend-unit-watch \"npx jest --config config/jest.unit.config.js --watch\"",
    "test:unit:coverage": "node ../scripts/tests/run-with-profile.cjs backend-unit-coverage \"npx jest --config config/jest.unit.config.js --coverage\"",
    "test:integration": "node ../scripts/tests/run-with-profile.cjs backend-integration \"npx jest --config config/jest.integration.config.js\"",
    "test:integration:watch": "node ../scripts/tests/run-with-profile.cjs backend-integration-watch \"npx jest --config config/jest.integration.config.js --watch\"",
    "test:integration:coverage": "node ../scripts/tests/run-with-profile.cjs backend-integration-coverage \"npx jest --config config/jest.integration.config.js --coverage\"",
    "qa:geofence-pilot": "node scripts/tests/validate-pilot-geofence.cjs",
    "test:e2e": "node ../scripts/tests/run-with-profile.cjs backend-e2e \"npx jest --config config/jest.config.js\"",
    "test:e2e:watch": "node ../scripts/tests/run-with-profile.cjs backend-e2e-watch \"npx jest --config config/jest.config.js --watch\"",
    "test:e2e:coverage": "node ../scripts/tests/run-with-profile.cjs backend-e2e-coverage \"npx jest --config config/jest.config.js --coverage\"",
    "test:e2e:passenger": "node ../scripts/tests/run-with-profile.cjs backend-e2e-passenger \"npx jest --config config/jest.config.js tests/e2e/backend/flows/passenger-flow.test.js\"",
    "test:e2e:driver": "node ../scripts/tests/run-with-profile.cjs backend-e2e-driver \"npx jest --config config/jest.config.js tests/e2e/backend/flows/driver-flow.test.js\"",
    "test:basic": "node test-integration.js",
    "test:architecture": "node test-architecture.js",
    "test:multiple-drivers": "node test-multiple-drivers.js",
    "test:optimizations": "node scripts/tests/test-optimizations.js",
    "smoke:prepare-test-users": "node scripts/tests/ensure-leaf-test-users.cjs",
    "smoke:runtime-critical-events": "node scripts/tests/smoke-runtime-critical-events.cjs",
    "smoke:runtime-full-ride-flow": "node scripts/tests/smoke-runtime-full-ride-flow.cjs",
    "smoke:runtime-redis-adapter": "node scripts/tests/smoke-runtime-redis-adapter.cjs",
    "smoke:woovi-sandbox": "node scripts/tests/smoke-woovi-sandbox.cjs",
    "smoke:supersede": "node scripts/tests/supersede-rebooking-smoke.cjs",
    "smoke:driver-ready": "node scripts/tests/smoke-driver-ready-booking.cjs",
    "smoke:socket-health": "node scripts/tests/smoke-socket-health.cjs",
    "smoke:socket-health:local": "node scripts/tests/smoke-socket-health.cjs",
    "smoke:socket-health:public": "WS_URL=https://socket.leaf.app.br node scripts/tests/smoke-socket-health.cjs",
    "ops:headroom:battery": "node scripts/tests/run-go-live-headroom-battery.cjs",
    "ops:financial-reconcile": "node scripts/ops/reconcile-financial-ledger.cjs",
    "ops:kyc-aws-preflight": "node scripts/ops/preflight-kyc-aws-driver.cjs",
    "check:single-backend-runtime": "node scripts/analysis/assert-single-backend-runtime.cjs",
    "report:ride-cost": "node scripts/tests/report-ride-cost-telemetry.cjs",
    "benchmark": "node scripts/benchmark/performance-benchmark.js",
    "stress-test": "node scripts/benchmark/stress-test.js",
    "admin:create": "node scripts/create-admin-user.js",
    "admin:create:profile": "node scripts/create-admin-profile-user.js",
    "admin:test": "node test-admin-auth.js",
    "config:validate": "node scripts/deploy/validate-runtime-config.js",
    "config:validate:real-sandbox": "ENV_FILE=.env.production.sandbox node scripts/deploy/validate-runtime-config.js",
    "ngrok:start": "node scripts/utils/start-ngrok.js",
    "ngrok:auto": "node scripts/utils/start-ngrok-auto.js",
    "ngrok:url": "node scripts/utils/get-ngrok-url.js",
    "test:route-guards": "node scripts/tests/assert-sensitive-route-guards.cjs",
    "test:redis-sentinel-failover": "node scripts/tests/redis-sentinel-failover.cjs",
    "backup:redis": "node scripts/ops/backup-redis.cjs",
    "verify:redis-restore": "node scripts/ops/verify-redis-restore.cjs",
    "test:redis-backup-restore": "node scripts/tests/redis-backup-restore.cjs"
  },
  "keywords": [
    "websocket",
    "redis",
    "firebase",
    "leaf",
    "taxi",
    "location"
  ],
  "author": "LEAF Team",
  "license": "ISC",
