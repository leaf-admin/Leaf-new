    "@aws-sdk/client-rekognition": "^3.1014.0",
    "@aws-sdk/client-sts": "^3.1014.0",
    "@graphql-tools/schema": "^10.0.25",
    "@graphql-tools/utils": "^10.9.1",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.220.0",
    "@opentelemetry/resources": "^2.9.0",
    "@opentelemetry/sdk-node": "^0.220.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@turf/boolean-point-in-polygon": "^7.3.4",
    "@turf/helpers": "^7.3.4",
    "apollo-server-core": "^3.13.0",
    "apollo-server-express": "^3.13.0",
    "axios": "^1.18.1",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dataloader": "^2.2.3",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.0.1",
    "express-validator": "^7.2.1",
    "firebase-admin": "^12.7.0",
    "form-data": "^4.0.6",
    "graphql": "^16.11.0",
    "graphql-cost-analysis": "^1.0.3",
    "graphql-depth-limit": "^1.1.0",
    "graphql-subscriptions": "^3.0.0",
    "h3-js": "^4.3.0",
    "ioredis": "^5.6.1",
    "jsonwebtoken": "^9.0.2",
    "ml-matrix": "^6.12.1",
    "multer": "^1.4.5-lts.1",
    "ngeohash": "^0.6.3",
    "node-cache": "^5.1.2",
    "node-cron": "^4.2.1",
    "node-fetch": "^3.3.2",
    "pdf-parse": "^1.1.4",
    "pdfkit": "^0.17.2",
    "prom-client": "^15.1.3",
    "redis": "^4.6.10",
    "sharp": "^0.33.5",
    "socket.io": "^4.7.2",
    "tesseract.js": "^5.0.4",
    "uuid": "^13.0.0",
    "winston": "^3.17.0",
    "ws": "^8.18.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@graphql-tools/mock": "^9.0.25",
    "mongodb-memory-server": "^11.0.1",
    "nodemon": "^3.0.1",
    "pdf-poppler": "^0.2.3",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2"
  }
}
