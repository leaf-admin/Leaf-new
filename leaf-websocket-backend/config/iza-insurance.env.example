# Seguro APP por corrida (IZA). Sem valores reais aqui: a credencial fica no .env
# do host (Santiago) e, localmente, em ~/.leaf-secrets/iza-hml.env.
#
# Homologação: IZA_ENV=hml e o host .hml. A credencial de homologação não funciona
# em produção (e o config:validate bloqueia a mistura de ambiente e host).
# A homologação só responde das 8h às 20h; fora disso devolve 503 em HTML.
#
# Ligar só com a integração validada. A cobrança dos R$ 0,13 na tarifa é outra
# flag (RIDE_INSURANCE_FEE_ENABLED) e continua desligada até a produção da IZA.
IZA_INSURANCE_ENABLED=false
IZA_ENV=hml
IZA_API_BASE_URL=https://intermittent-web-api.hml.iza.com.vc/api/integrations
IZA_USER_API_ID=
IZA_SECRET_KEY=
# Opcional (padrão 10000)
IZA_API_TIMEOUT_MS=10000
