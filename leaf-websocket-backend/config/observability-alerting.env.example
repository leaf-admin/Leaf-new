# Leaf observability and alerting
# Copy the needed keys into the real production env file. Do not commit secrets.

NODE_ENV=production
LEAF_DASHBOARD_URL=https://dashboard.leaf.example/observability

# Discord realtime alerts
DISCORD_ALERT_WEBHOOK_URL=
DISCORD_CRITICAL_ALERT_WEBHOOK_URL=
DISCORD_ALERT_MENTION=
DISCORD_ALERT_USERNAME=Leaf Observability

# Daily business report channel (for example, Discord channel leaf-earnings).
# The payload includes AWS KYC dispatched sessions and estimated USD/BRL cost.
# Keep the real webhook only in the production env/secret store.
DISCORD_EARNINGS_WEBHOOK_URL=
DISCORD_EARNINGS_USERNAME=Leaf Earnings

# Alert routing
ALERT_COOLDOWN_MINUTES=15
ALERT_WEBHOOK_SECRET=
ALERT_WEBHOOK_SEND_RESOLVED=false

# Ride cost monitor. Woovi is intentionally excluded from these numbers.
RIDE_COST_ALERTS_ENABLED=true
RIDE_COST_ALERT_WINDOW_SIZE=20
RIDE_COST_ALERT_MIN_COMPLETED_RIDES=5
RIDE_COST_WARNING_BRL=0.20
RIDE_COST_CRITICAL_BRL=0.30
RIDE_COST_DIRECTIONS_WARNING_PER_RIDE=2.2
RIDE_COST_DIRECTIONS_CRITICAL_PER_RIDE=3
RIDE_COST_ALERT_CHECK_INTERVAL_MS=60000
RIDE_COST_TELEMETRY_USD_BRL_RATE=5.20

# Sends the previous day summary at 06:05 America/Sao_Paulo.
DAILY_EARNINGS_REPORT_ENABLED=true
DAILY_EARNINGS_REPORT_CRON=5 6 * * *
DAILY_EARNINGS_REPORT_SEND_EMPTY=true
LEAF_REPORT_TIME_ZONE=America/Sao_Paulo

# Sentry error/performance monitoring
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_PROFILES_SAMPLE_RATE=0.01

# Grafana Cloud remote write, when moving metrics out of the VPS
GRAFANA_CLOUD_PROMETHEUS_URL=
GRAFANA_CLOUD_PROMETHEUS_USER=
GRAFANA_CLOUD_PROMETHEUS_TOKEN=

# Product analytics
POSTHOG_PROJECT_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
