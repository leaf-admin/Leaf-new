# Contrato de descoberta de mestre Redis via Sentinel.
# Produção exige três ou mais Sentinels distintos em quantidade ímpar.
REDIS_MODE=sentinel
REDIS_SENTINELS=sentinel-a.internal:26379,sentinel-b.internal:26379,sentinel-c.internal:26379
REDIS_SENTINEL_MASTER_NAME=leaf-master
REDIS_SENTINEL_USERNAME=
REDIS_SENTINEL_PASSWORD=replace-with-secret-manager-value

# Credenciais do Redis promovível (não são as credenciais do Sentinel).
REDIS_USERNAME=
REDIS_PASSWORD=replace-with-secret-manager-value
REDIS_DB=0

# Ative somente quando os endpoints estiverem provisionados com TLS.
REDIS_USE_TLS=false
REDIS_TLS_REJECT_UNAUTHORIZED=true
REDIS_SENTINEL_USE_TLS=false
REDIS_SENTINEL_TLS_REJECT_UNAUTHORIZED=true
