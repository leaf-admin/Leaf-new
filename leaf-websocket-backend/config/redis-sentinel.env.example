# Contrato de descoberta de mestre Redis via Sentinel.
# Produção exige três ou mais Sentinels distintos em quantidade ímpar.
REDIS_MODE=sentinel
REDIS_SENTINELS=sentinel-a.internal:26379,sentinel-b.internal:26379,sentinel-c.internal:26379
REDIS_SENTINEL_MASTER_NAME=leaf-master
REDIS_SENTINEL_USERNAME=
REDIS_SENTINEL_PASSWORD=replace-with-secret-manager-value

# Credenciais do Redis promovível (não são as credenciais do Sentinel).
REDIS_USERNAME=
REDIS_PASSWORD=replace-with-secret-manager-value
REDIS_DB=0

# Identificador único deste runtime/host. Evita colisão entre Redis Stream
# consumers quando containers em máquinas distintas usam o mesmo PID.
LEAF_WORKER_INSTANCE_ID=replace-with-unique-runtime-id

# Ative somente quando os endpoints estiverem provisionados com TLS.
REDIS_USE_TLS=false
REDIS_TLS_REJECT_UNAUTHORIZED=true
REDIS_SENTINEL_USE_TLS=false
REDIS_SENTINEL_TLS_REJECT_UNAUTHORIZED=true

# Evidência obrigatória para liberar lançamento amplo. Os domínios devem ser
# realmente independentes; o drill deve ser renovado ao menos a cada 30 dias.
REDIS_HA_FAILURE_DOMAINS=redis-domain-a,redis-domain-b,redis-domain-c
REDIS_HA_FAILOVER_DRILL_ID=replace-with-real-change-ticket-or-run-id
REDIS_HA_FAILOVER_DRILL_AT=2026-08-02T12:00:00.000Z

# Borda redundante e health-checked. Modos aceitos:
# managed_load_balancer | self_managed_failover
LEAF_EDGE_HA_MODE=managed_load_balancer
LEAF_EDGE_HA_FAILURE_DOMAINS=edge-domain-a,edge-domain-b
LEAF_EDGE_HA_FAILOVER_DRILL_ID=replace-with-real-change-ticket-or-run-id
LEAF_EDGE_HA_FAILOVER_DRILL_AT=2026-08-02T12:00:00.000Z
