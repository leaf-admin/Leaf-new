# Leaf AWS KYC strict activation manifest
# Copy values into the target secret store/.env; do not commit real secrets.

NODE_ENV=production
AWS_REGION=us-east-1
KYC_AWS_CREDENTIAL_SOURCE=static
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

KYC_PRODUCTION_BIOMETRICS_ENABLED=true
# Firestore is the only positive KYC authority. RTDB/Redis remain replicas whose
# blocking signals still fail closed.
KYC_STRICT_PRODUCTION_MODE=true
KYC_REQUIRE_TRUSTED_BIOMETRIC_MATCH=true
KYC_ALLOW_LEGACY_DEVICE_SIGNATURE=false
KYC_ALLOW_AWS_LIVENESS_ONLY_MATCH=false
MOBILE_FACE_EMBEDDING_ENABLED=false
MOBILE_FACE_EMBEDDING_LOCAL_COMPARE_FALLBACK=false

KYC_AWS_LIVENESS_ENABLED=true
KYC_AWS_LIVENESS_CREDENTIALS_ENABLED=true
KYC_AWS_LIVENESS_ASSUME_ROLE_ARN=
KYC_AWS_LIVENESS_ASSUME_ROLE_EXTERNAL_ID=
KYC_AWS_LIVENESS_STS_SESSION_NAME_PREFIX=leaf-liveness
KYC_AWS_LIVENESS_STS_DURATION_SECONDS=900
KYC_AWS_LIVENESS_S3_BUCKET=
KYC_AWS_LIVENESS_CONFIDENCE_THRESHOLD=80
# AWS Face Liveness aceita a sessao por no maximo 180s. A metadata de binding
# permanece internamente pela janela de tentativas para provar a expiracao sem
# abrir outra reserva paga de forma ambigua.
KYC_AWS_LIVENESS_SESSION_TTL_SECONDS=180
KYC_AWS_LIVENESS_MAX_ATTEMPTS_PER_WINDOW=5
KYC_AWS_LIVENESS_ATTEMPT_WINDOW_SECONDS=900
KYC_AWS_LIVENESS_SOFT_BLOCK_ON_EXHAUSTED=false
KYC_AWS_LIVENESS_IDEMPOTENT_RETRY_DELAY_SECONDS=2
KYC_AWS_LIVENESS_IDEMPOTENT_RETRY_WINDOW_SECONDS=120
KYC_AWS_LIVENESS_ESTIMATED_UNIT_COST_USD=0.015

# Distributed admission below the default AWS Rekognition quotas (25 TPS and
# 75 concurrent liveness sessions). The bounded wait absorbs short bursts
# without creating an unbounded application queue.
KYC_AWS_ADMISSION_CONTROL_ENABLED=true
KYC_AWS_ADMISSION_CREATE_TPS=20
KYC_AWS_ADMISSION_CREATE_BURST=20
KYC_AWS_ADMISSION_RESULT_TPS=20
KYC_AWS_ADMISSION_RESULT_BURST=20
KYC_AWS_ADMISSION_MAX_CONCURRENT_SESSIONS=70
KYC_AWS_ADMISSION_LEASE_TTL_SECONDS=180
KYC_AWS_ADMISSION_MAX_WAIT_MS=15000
KYC_AWS_ADMISSION_RETRY_FLOOR_MS=40

KYC_FACE_COMPARE_PROVIDER=aws_rekognition_compare_faces
KYC_AWS_COMPARE_FACES_ENABLED=true
KYC_AWS_COMPARE_FACES_APPROVE_THRESHOLD=0.95
KYC_AWS_COMPARE_FACES_REVIEW_THRESHOLD=0.80
KYC_AWS_COMPARE_FACES_QUALITY_FILTER=AUTO
KYC_AWS_COMPARE_FACES_ESTIMATED_UNIT_COST_USD=0.001
KYC_AWS_COMPARE_FACES_SDK_MAX_ATTEMPTS=1
KYC_AWS_COMPARE_RESULT_PERSIST_MAX_ATTEMPTS=3
KYC_CANONICAL_TRUSTED_BIOMETRIC_MATCH_PROVIDERS=aws_rekognition_compare_faces
# Legacy Leaf embedding shadow path must stay off in the canonical AWS profile.
ENABLE_CNH_FACE_BIOMETRICS=false

# Hard budget guard: conservative pilot limits, no external worker required.
KYC_AWS_COST_GUARD_ENABLED=true
KYC_AWS_COST_DAILY_LIMIT_USD=2.50
KYC_AWS_COST_MONTHLY_LIMIT_USD=50.00
KYC_AWS_COST_PER_USER_DAILY_SESSION_LIMIT=20
KYC_AWS_COST_TIME_ZONE=UTC
KYC_AWS_COST_OPERATION_RETENTION_DAYS=35

KYC_FIRST_ACCESS_ENFORCE_LIVENESS=true
DAILY_KYC_ONLINE_GATE_ENABLED=true
KYC_TRUST_CADENCE_ENABLED=true
ENABLE_ACTIVE_TRIP_INDEX=true
# Runtime Redis is accepted only after the live probe proves noeviction, AOF
# everysec, zero evictions, safe memory headroom and the expected dataset.
KYC_ACTIVE_TRIP_AUTHORITY_MODE=redis_noeviction
REDIS_CRITICAL_AUTHORITY_ATTESTATION_ENABLED=true
REDIS_CRITICAL_DATASET_QUARANTINE_ENABLED=true
# Deployment must set this to the generation already stored in the persistent
# marker below. The application never creates or repairs the marker; missing or
# mismatched data quarantines new KYC/ride claims.
REDIS_CRITICAL_DATASET_GENERATION=
REDIS_CRITICAL_DATASET_GENERATION_KEY=leaf:runtime:critical-dataset:generation
REDIS_CRITICAL_MEMORY_WARNING_PERCENT=60
REDIS_CRITICAL_MEMORY_HIGH_PERCENT=75
REDIS_CRITICAL_MEMORY_CRITICAL_PERCENT=85
REDIS_CRITICAL_ATTESTATION_CACHE_TTL_MS=5000
# Runtime readiness stays quarantined until this consumer group exists. The
# existing worker-trip-location process must be deployed through a separately
# approved operations change; this manifest does not start it.
ENABLE_TRIP_LOCATION_STREAM=true
TRIP_LOCATION_WORKER_GROUP=trip-location-workers
# XINFO CONSUMERS must show at least one consumer with idle at or below this limit.
TRIP_LOCATION_CONSUMER_MAX_IDLE_MS=30000
TRIP_LOCATION_STREAM_SAFE_TRIM_THRESHOLD=500000
WORKER_STREAM_SAFE_TRIM_THRESHOLD=500000
WORKER_STREAM_TRIM_CHECK_EVERY_ACKS=5000
WORKER_DLQ_MAXLEN=10000
# Host prerequisite checked before deployment, never mutated by the app:
# sysctl vm.overcommit_memory must equal 1.
# Increment this version whenever the biometric model, thresholds, or trust
# policy changes so evidence issued under the previous contract is revalidated.
KYC_TRUST_POLICY_VERSION=driver_identity_recurring_v2
KYC_TRUST_T0_MAX_AGE_HOURS=24
KYC_TRUST_T1_MAX_AGE_HOURS=72
KYC_TRUST_T2_MAX_AGE_HOURS=168
KYC_TRUST_T1_MIN_DISTINCT_SUCCESS_DAYS=7
KYC_TRUST_T2_MIN_AGE_DAYS=30
KYC_TRUST_T2_MIN_SUCCESS_COUNT=14
KYC_TRUST_T2_MIN_DISTINCT_SUCCESS_DAYS=14
KYC_TRUSTED_RANDOM_AUDIT_PERCENT=10
KYC_TRUST_RANDOM_AUDIT_TIME_ZONE=America/Sao_Paulo
KYC_TRUST_RANDOM_AUDIT_DECISION_TTL_SECONDS=172800
KYC_TRUST_STATE_CACHE_TTL_SECONDS=300
KYC_CANONICAL_SESSION_CLAIM_TTL_SECONDS=120
KYC_IDENTITY_VERIFICATION_WINDOW_TTL_SECONDS=1500
ENABLE_LEGACY_GRAPHQL=false
ENABLE_LEGACY_DRIVER_RESPONSE_ACCEPT=false
