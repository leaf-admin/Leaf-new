# Temporary physical E2E profile. Never use for public intake.
LEAF_LAUNCH_PROFILE=ride_flow_validation
LEAF_RIDE_FLOW_VALIDATION_ACK=true
# The profile itself enables the controlled cohort. Keep this false so the
# later production KYC gate is not activated during ride-flow validation.
LEAF_PILOT_CONTROLLED=false
LEAF_ACCEPT_NEW_PIX=true
LEAF_ACCEPT_NEW_BOOKINGS=true

# O sandbox normalmente alonga TTLs para smokes automatizados. Nesta etapa
# física, a oferta precisa reproduzir a janela real e expirar em vídeo.
SMOKE_DRIVER_RESPONSE_TIMEOUT_SECONDS=20

# Exactly one approved passenger and one approved driver.
PILOT_PASSENGER_ACCESS_MODE=cohort
PILOT_ALLOWED_PASSENGER_IDS=
PILOT_ALLOWED_DRIVER_IDS=
PILOT_MAX_DRIVER_COHORT_SIZE=250
PILOT_REGION_IDS=rio-zona-sul-centro-lapa-v1

GEOFENCE_FAIL_CLOSED=true
GEOFENCE_REQUIRE_DESTINATION_INSIDE_REGION=true
GEOFENCE_REGION_FILE=config/geofence.json
LEAF_RUNTIME_POLICY_VERSION=ride-flow-validation-v1

# PaymentService additionally requires the selected runtime profile to be:
# environment=sandbox, scope=users, testUserSandbox=true.
