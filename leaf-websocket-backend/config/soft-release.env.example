# Soft release profile (HTTP + Socket rate limits)
# Copy required keys to your runtime environment (VPS, Docker env, etc.)

# HTTP limiter (middleware/rateLimiter.js)
RATE_LIMIT_HTTP_GENERAL_WINDOW_SECONDS=60
RATE_LIMIT_HTTP_GENERAL=200
RATE_LIMIT_HTTP_AUTH_WINDOW_SECONDS=900
RATE_LIMIT_HTTP_AUTH=8
RATE_LIMIT_HTTP_LOCATION_WINDOW_SECONDS=60
RATE_LIMIT_HTTP_LOCATION=240
RATE_LIMIT_HTTP_WEBSOCKET_WINDOW_SECONDS=60
RATE_LIMIT_HTTP_WEBSOCKET=220
RATE_LIMIT_HTTP_PAYMENT_WINDOW_SECONDS=60
RATE_LIMIT_HTTP_PAYMENT=80

# Socket limiter (services/rate-limiter-service.js)
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_FLOW_CORE=80
RATE_LIMIT_CREATE_BOOKING=80
RATE_LIMIT_CONFIRM_PAYMENT=80
RATE_LIMIT_START_TRIP=80
RATE_LIMIT_FINISH_TRIP=80
RATE_LIMIT_ACCEPT_RIDE=120
RATE_LIMIT_CANCEL_RIDE=20
RATE_LIMIT_REJECT_RIDE=240
RATE_LIMIT_UPDATE_LOCATION=2400
RATE_LIMIT_UPDATE_DRIVER_LOCATION=3000
RATE_LIMIT_SEARCH_DRIVERS=600
RATE_LIMIT_SEND_MESSAGE=180

# Legacy compatibility gates (recommended off for clean production flow)
ENABLE_LEGACY_SOCKET_NOTIFICATIONS=false
ENABLE_LEGACY_SOCKET_BRIDGE=false
ENABLE_LEGACY_UPDATE_DRIVER_LOCATION_EVENT=false
ENABLE_LEGACY_RUNTIME_ENDPOINTS=false
ENABLE_LEGACY_AUTH_VERIFY_ROUTE=false
ENABLE_LEGACY_ACCOUNT_DELETE_ROUTES=false
ENABLE_LEGACY_WOOVI_ALIAS_ROUTE=false
ENABLE_LEGACY_NO_DRIVERS_FOUND_EVENT=false
ENABLE_LEGACY_PROMOTIONS_ROUTES=false
ENABLE_RIDE_EXTENSION_FLOW=true
ENABLE_RIDER_EARLY_END=true
ENABLE_OPERATIONAL_REASSIGNMENT=false
ENABLE_MULTI_LEG_BILLING=false
RIDE_EXTENSION_PAYMENT_TIMEOUT_SEC=300
# Extension Pix charge = positive fare delta + route recalculation cost + Pix processing fee.
# Set cents explicitly for production if telemetry defaults are not the approved pass-through cost.
RIDE_EXTENSION_ROUTE_RECALCULATION_COST_CENTS=6

# Ride dispatch tuning (driver matching / newRideRequest)
# Candidate query size used in Redis GEO lookup (dynamic between MIN and MAX by wave size)
DISPATCH_GEO_CANDIDATE_MIN=120
DISPATCH_GEO_CANDIDATE_MAX=800
# Scored pool kept after ranking (dynamic between MIN and MAX by wave size)
DISPATCH_SCORE_POOL_MIN=24
DISPATCH_SCORE_POOL_MAX=200
# Driver response window (seconds): lock TTL + on-screen notification + timeout
DISPATCH_DRIVER_RESPONSE_TIMEOUT_SECONDS=20

# Queue worker tuning (regions + batch per loop)
QUEUE_WORKER_INTERVAL_MS=1000
QUEUE_WORKER_BATCH_SIZE_PER_REGION=10
QUEUE_WORKER_MAX_REGIONS_PER_ITERATION=50

# Woovi environment split
# Use sandbox in homolog/test and production in live environment.
WOOVI_ENVIRONMENT=sandbox
WOOVI_BASE_URL=https://api.woovi-sandbox.com/api/v1
# Production example:
# WOOVI_ENVIRONMENT=production
# WOOVI_BASE_URL=https://api.woovi.com/api/v1
# Production must override the sandbox defaults below with the strict values in the next block.
WOOVI_WEBHOOK_REQUIRE_SIGNATURE=false
WOOVI_WEBHOOK_ALLOW_UNSIGNED=true
WOOVI_WEBHOOK_PROVIDER_VERIFICATION_REQUIRED=true
# Opcional: se configurado, o webhook exige este token no header Authorization.
# WOOVI_WEBHOOK_AUTHORIZATION=Bearer <token-seguro>
# In production, set one real verifier and keep unsigned disabled. The deploy validator blocks otherwise.
# WOOVI_WEBHOOK_REQUIRE_SIGNATURE=true
# WOOVI_WEBHOOK_ALLOW_UNSIGNED=false
# WOOVI_WEBHOOK_PROVIDER_VERIFICATION_REQUIRED=true
# WOOVI_WEBHOOK_PUBLIC_KEY=
# WOOVI_WEBHOOK_SIGNATURE_SECRET=
# WOOVI_WEBHOOK_HMAC_SECRET=

# Security & observability hints
CORS_ORIGIN=https://app.leaf.example,https://dashboard.leaf.example
ALLOW_PRIVATE_CORS=false
ALLOW_NGROK_CORS=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# Controlled pilot launch profile
# Use pilot_controlled for the first assisted rollout with scope frozen to core ride flow.
LEAF_LAUNCH_PROFILE=pilot_controlled
ENABLE_DRIVER_WITHDRAWALS=false
ENABLE_REFERRAL_PROGRAMS=false
ENABLE_CAMPAIGN_CENTER=false
ENABLE_LEAF_DELAS=false
ENABLE_DRIVER_DESTINATION_MODE=false
ENABLE_DYNAMIC_PRICING=false
ENABLE_DEMAND_PREDICTION=false
ENABLE_SMART_PUSH=false
ENABLE_SOFT_BAN_ENFORCEMENT=false
ENABLE_ADMIN_MUTATIONS=false

# Health thresholds for small VPS pilot / soft release.
# The full /health should only go critical under sustained CPU pressure.
HEALTH_SYSTEM_MEMORY_WARNING_PERCENT=80
HEALTH_SYSTEM_MEMORY_CRITICAL_PERCENT=92
HEALTH_SYSTEM_CPU_WARNING_PERCENT=120
HEALTH_SYSTEM_CPU_CRITICAL_PERCENT=200
HEALTH_SYSTEM_CPU_SUSTAINED_CRITICAL_PERCENT=140

# KYC device-first (release hardening)
# Keep heavy face processing on device and lightweight validation on backend.
KYC_SIMILARITY_THRESHOLD=0.5
# Keep false in soft-release to avoid per-request heavy writes/logs.
KYC_WRITE_AUDIT_KEY=false
KYC_LOG_SUCCESS_VERBOSE=false

# AWS Rekognition Face Liveness - production runtime config
# You can use Rekognition Liveness standalone (plus IAM credentials).
KYC_AWS_LIVENESS_ENABLED=true
AWS_REGION=us-east-1
KYC_AWS_LIVENESS_CONFIDENCE_THRESHOLD=80
KYC_AWS_LIVENESS_SESSION_TTL_SECONDS=165
KYC_AWS_LIVENESS_AUDIT_IMAGES_LIMIT=0
# Approved low-friction challenge. The only supported alternative is
# FaceMovementAndLightChallenge.
KYC_AWS_LIVENESS_CHALLENGE_TYPE=FaceMovementChallenge
# Operational estimate for per-session cost dashboards/runbooks. Keep in sync
# with the current AWS Rekognition Face Liveness price in the deployed region.
KYC_AWS_LIVENESS_ESTIMATED_UNIT_COST_USD=0.015
KYC_AWS_LIVENESS_MAX_ATTEMPTS_PER_WINDOW=2
KYC_AWS_LIVENESS_WITHDRAWAL_MAX_ATTEMPTS_PER_WINDOW=2
KYC_AWS_LIVENESS_ATTEMPT_WINDOW_SECONDS=86400
KYC_AWS_LIVENESS_REFERENCE_RESULT_MAX_READS=3
KYC_AWS_LIVENESS_REFERENCE_RESULT_RETRY_DELAY_MS=250
KYC_AWS_LIVENESS_PROVIDER_RECOVERY_MAX_CREDITS=3
KYC_AWS_LIVENESS_SOFT_BLOCK_ON_EXHAUSTED=true
KYC_AWS_LIVENESS_SDK_MAX_ATTEMPTS=2
KYC_AWS_LIVENESS_CREDENTIALS_ENABLED=true
KYC_AWS_LIVENESS_STS_DURATION_SECONDS=900
# Mandatory for temporary credentials to web/mobile liveness streaming:
KYC_AWS_LIVENESS_ASSUME_ROLE_ARN=
# Optional:
# KYC_AWS_LIVENESS_ASSUME_ROLE_EXTERNAL_ID=
# KYC_AWS_LIVENESS_STS_SESSION_NAME_PREFIX=leaf-liveness
# Optional for legacy/manual flows only. Keep empty while
# KYC_TRUST_CADENCE_ENABLED=true until ReferenceImage.S3Object is supported.
# KYC_AWS_LIVENESS_S3_BUCKET=your-bucket-name
# KYC_AWS_LIVENESS_S3_PREFIX=kyc/liveness
# Do not commit real AWS keys here. Prefer IAM role in production.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Canonical face match after AWS Liveness. This provider receives only the
# approved CNH portrait crop and the AWS Liveness ReferenceImage.
KYC_FACE_COMPARE_PROVIDER=aws_rekognition_compare_faces
KYC_AWS_COMPARE_FACES_ENABLED=true
KYC_AWS_COMPARE_FACES_APPROVE_THRESHOLD=0.95
KYC_AWS_COMPARE_FACES_REVIEW_THRESHOLD=0.80
KYC_AWS_COMPARE_FACES_QUALITY_FILTER=AUTO
KYC_AWS_COMPARE_FACES_ESTIMATED_UNIT_COST_USD=0.001
KYC_AWS_COMPARE_FACES_SDK_MAX_ATTEMPTS=2
KYC_CANONICAL_TRUSTED_BIOMETRIC_MATCH_PROVIDERS=biometric-face-service,leaf_face_compare_service,aws_rekognition_compare_faces

# KYC policy gate (withdraw + complaint reverify + first access)
KYC_FIRST_ACCESS_ENFORCE_LIVENESS=true
# Recurring online identity policy. Keep disabled until AWS liveness, trusted
# server-side compare and Firestore readiness are all green in the target env.
DAILY_KYC_ONLINE_GATE_ENABLED=true
KYC_TRUST_CADENCE_ENABLED=false
KYC_TRUST_POLICY_VERSION=driver_identity_recurring_v1
KYC_TRUST_T0_MAX_AGE_HOURS=24
KYC_TRUST_T1_MAX_AGE_HOURS=72
KYC_TRUST_T2_MAX_AGE_HOURS=168
KYC_TRUST_T1_MIN_DISTINCT_SUCCESS_DAYS=7
KYC_TRUST_T2_MIN_AGE_DAYS=30
KYC_TRUST_T2_MIN_SUCCESS_COUNT=14
# One server-side random decision per trusted driver/active day. A selected
# driver is challenged only outside an active ride; 5 means five percent.
KYC_TRUSTED_RANDOM_AUDIT_PERCENT=5
KYC_TRUST_RANDOM_AUDIT_TIME_ZONE=America/Sao_Paulo
KYC_TRUST_RANDOM_AUDIT_DECISION_TTL_SECONDS=172800
KYC_TRUST_STATE_CACHE_TTL_SECONDS=300
# Distributed claim prevents one AWS session from being compared twice.
KYC_CANONICAL_SESSION_CLAIM_TTL_SECONDS=120
# Renewed while server-side compare runs; also blocks ride acceptance atomically.
KYC_IDENTITY_VERIFICATION_WINDOW_TTL_SECONDS=1500
# Legacy proxy stays isolated and is blocked by production config validation.
ENABLE_LEGACY_KYC_PROXY=false
KYC_WITHDRAW_VERIFICATION_MAX_AGE_HOURS=24
KYC_WITHDRAW_LOW_RISK_VERIFICATION_MAX_AGE_HOURS=168
KYC_WITHDRAW_MEDIUM_RISK_VERIFICATION_MAX_AGE_HOURS=72
KYC_WITHDRAW_HIGH_RISK_VERIFICATION_MAX_AGE_HOURS=24
KYC_WITHDRAW_VERIFY_SCORE_THRESHOLD=40
KYC_WITHDRAW_LIVENESS_SCORE_THRESHOLD=70
KYC_WITHDRAW_MEDIUM_AMOUNT_CENTS=50000
KYC_WITHDRAW_HIGH_AMOUNT_CENTS=120000
KYC_WITHDRAW_DAILY_LIMIT_CENTS=300000
KYC_WITHDRAW_BURST_WINDOW_MINUTES=30
KYC_WITHDRAW_BURST_COUNT_THRESHOLD=2
KYC_WITHDRAW_CHALLENGE_TTL_SECONDS=1200
KYC_PHOTO_MISMATCH_WINDOW_DAYS=30
# Optional custom keywords (comma-separated, lowercase preferred)
# KYC_PHOTO_MISMATCH_KEYWORDS=motorista diferente,nao era o motorista,foto diferente
