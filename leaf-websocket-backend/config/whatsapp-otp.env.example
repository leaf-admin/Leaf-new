# WhatsApp OTP for passenger/driver sign-up and login (/api/custom-otp).
# Keep AUTH_OTP_PROVIDER=firebase until the Meta template is approved and a
# real delivery smoke passed. Supply real values only in the protected runtime.
# The app falls back to Firebase SMS when this provider answers 502/503.
AUTH_OTP_PROVIDER=whatsapp
WHATSAPP_META_ACCESS_TOKEN=
WHATSAPP_META_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE_NAME=
WHATSAPP_OTP_TEMPLATE_LANGUAGE=pt_BR
WHATSAPP_META_GRAPH_VERSION=v23.0
# Dedicated secret, at least 32 bytes. Only the HMAC of each code is stored.
AUTH_OTP_HMAC_KEY=
