# WhatsApp Cloud API OTP (Meta)
# Copie estas variáveis para o ambiente do gateway; não comite valores reais.

AUTH_OTP_PROVIDER=whatsapp
AUTH_OTP_HMAC_KEY=

WHATSAPP_META_ACCESS_TOKEN=
WHATSAPP_META_PHONE_NUMBER_ID=
# O WABA ID é útil para provisionar/inspecionar templates, mas não é enviado
# no request de mensagem.
WHATSAPP_META_WABA_ID=
WHATSAPP_META_GRAPH_BASE_URL=https://graph.facebook.com
WHATSAPP_META_GRAPH_VERSION=v23.0

# Nome e locale precisam ser exatamente os do template AUTHENTICATION aprovado.
WHATSAPP_OTP_TEMPLATE_NAME=
WHATSAPP_OTP_TEMPLATE_LANGUAGE=pt_BR
WHATSAPP_OTP_TIMEOUT_MS=10000
WHATSAPP_OTP_MAX_ATTEMPTS=2
WHATSAPP_OTP_RETRY_DELAY_MS=150

# Somente ambientes locais sem Meta configurada podem simular a entrega.
# O runtime de produção ignora este modo e fecha com erro se não houver Meta.
AUTH_OTP_SIMULATION_ENABLED=false
