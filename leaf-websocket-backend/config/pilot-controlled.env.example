# Controlled pilot overlay
# Apply together with your normal runtime secrets for the first pilot-controlled release.

LEAF_LAUNCH_PROFILE=pilot_controlled

# Freeze non-core surfaces during the pilot.
ENABLE_DRIVER_WITHDRAWALS=false
ENABLE_REFERRAL_PROGRAMS=false
ENABLE_CAMPAIGN_CENTER=false
ENABLE_LEAF_DELAS=false
ENABLE_DRIVER_DESTINATION_MODE=false
ENABLE_DYNAMIC_PRICING=false
ENABLE_DEMAND_PREDICTION=false
ENABLE_SMART_PUSH=false
ENABLE_SOFT_BAN_ENFORCEMENT=false
ENABLE_ADMIN_MUTATIONS=false

# Core ride lifecycle kept on.
ENABLE_RIDE_EXTENSION_FLOW=true
ENABLE_RIDER_EARLY_END=true
ENABLE_OPERATIONAL_REASSIGNMENT=false
ENABLE_MULTI_LEG_BILLING=false
RIDE_EXTENSION_PAYMENT_TIMEOUT_SEC=300
# Extension Pix charge = positive fare delta + route recalculation cost + Pix processing fee.
RIDE_EXTENSION_ROUTE_RECALCULATION_COST_CENTS=6

# Health thresholds tuned for a controlled pilot on a small VPS.
# Keep short CPU spikes as warning; only mark critical when pressure is sustained.
HEALTH_SYSTEM_MEMORY_WARNING_PERCENT=80
HEALTH_SYSTEM_MEMORY_CRITICAL_PERCENT=92
HEALTH_SYSTEM_CPU_WARNING_PERCENT=120
HEALTH_SYSTEM_CPU_CRITICAL_PERCENT=200
HEALTH_SYSTEM_CPU_SUSTAINED_CRITICAL_PERCENT=140

# Pilot geography and categories should remain restricted operationally.
# Example:
# PILOT_CITY_ID=sao_paulo_centro
# PILOT_ALLOWED_CATEGORIES=leaf_plus,leaf_moto
# Dynamic pricing rollout:
# - legacy: regra combinada anterior
# - dry_run: cobra pela regra anterior e compara demanda v2 sem afetar o usuário
# - active: trânsito afeta o tempo da rota; pressão demanda/oferta afeta o adicional
PRICING_DEMAND_PRESSURE_MODE=dry_run

# Driver map: Google traffic is visual-only; H3 remains Leaf supply/demand.
ENABLE_DRIVER_TRAFFIC_LAYER=true
H3_MAP_CACHE_TTL_MS=10000
H3_MAP_CLIENT_REFRESH_INTERVAL_MS=60000
H3_MAP_CLIENT_STALE_AFTER_MS=120000
