FACE_SERVICE_NAME=Leaf Face Compare Service
FACE_SERVICE_VERSION=0.1.0

# Required for biometric endpoints. Use a long random secret in production.
# Generate with: openssl rand -hex 32
FACE_API_KEYS=change-me-long-random-secret
FACE_API_KEY_HEADER=X-Leaf-Biometric-Key

# Required only when using deploy/docker-compose.vps.yml + Caddy.
FACE_PUBLIC_DOMAIN=biometric.example.com
FACE_MAX_REQUEST_BODY_SIZE=10MB

# InsightFace model pack. buffalo_l includes SCRFD detection and ArcFace recognition.
INSIGHTFACE_MODEL_PACK=buffalo_l
INSIGHTFACE_ALLOWED_MODULES=detection,recognition
INSIGHTFACE_PROVIDERS=CPUExecutionProvider
INSIGHTFACE_CTX_ID=-1
# 320 is the shared-VPS pilot default. Use 640 on a dedicated VPS if accuracy testing needs it.
INSIGHTFACE_DET_SIZE=320,320

# Operational thresholds for cosine similarity.
# CNH Digital PDF vs selfie should be calibrated with Leaf's own dataset.
FACE_APPROVE_THRESHOLD=0.61
FACE_REVIEW_THRESHOLD=0.40

# Keep startup fast. First face request loads/downloads the model pack.
FACE_LOAD_MODEL_ON_STARTUP=false
# Keep API docs closed by default. Enable only in a private development network.
FACE_EXPOSE_DOCS=false

FACE_MAX_IMAGE_BYTES=8388608

# VPS safety defaults. Keep the pilot contained on the shared Contabo host.
FACE_HOST_PORT=8008
FACE_CONTAINER_CPUS=1.25
FACE_CONTAINER_MEMORY=3g
FACE_OMP_NUM_THREADS=1
FACE_OPENBLAS_NUM_THREADS=1
FACE_MKL_NUM_THREADS=1
FACE_NUMEXPR_NUM_THREADS=1
FACE_LEAF_DOCKER_NETWORK=leaf-app_leaf-network
FACE_LEAF_DOCKER_ALIAS=leaf-face-compare-service
