{
  "name": "leaf-support-agent-orchestrator",
  "version": "0.1.0",
  "private": true,
  "description": "Servico desacoplado para triagem, playbook e orquestracao de agents de suporte Leaf.",
  "main": "src/index.js",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "check": "find src -name '*.js' -print -exec node --check {} \\;",
    "test": "node --test $(find src -name '*.test.js' -print)"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.7.0",
    "socket.io-client": "^4.8.1"
  }
}
