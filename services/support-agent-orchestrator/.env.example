PORT=3015
NODE_ENV=development

# Backend Leaf atual. O orquestrador usa estas APIs sem acoplar codigo ao backend.
LEAF_API_BASE_URL=http://localhost:3001/api
LEAF_API_TOKEN=
LEAF_API_TIMEOUT_MS=12000

# Dashboard. Obrigatorio fora de teste: defina o mesmo token no servidor do dashboard
# como SUPPORT_ORCHESTRATOR_TOKEN. Nao exponha como NEXT_PUBLIC_*.
SUPPORT_ORCHESTRATOR_TOKEN=
SUPPORT_ORCHESTRATOR_ALLOW_MISSING_TOKEN=false
CORS_ORIGIN=http://localhost:3000,http://localhost:3002,http://localhost:3003

# Playbook fechado. Sem internet/web search.
SUPPORT_PLAYBOOK_PATH=../../docs/support/LEAF_SUPPORT_PLAYBOOK.md
SUPPORT_AUTONOMOUS_MODE=false
SUPPORT_MIN_CONFIDENCE=0.72
SUPPORT_STORE_PATH=.data/support-orchestrator-store.json

# Entrada em tempo real opcional. Para MVP tambem funciona com polling HTTP.
ENABLE_SUPPORT_POLLING=true
SUPPORT_POLL_INTERVAL_MS=30000
ENABLE_REDIS_SUBSCRIBER=false
REDIS_URL=redis://localhost:6379
SUPPORT_CHAT_REDIS_CHANNEL=support:chat:messages
ENABLE_SOCKET_LISTENER=false
LEAF_WS_URL=http://localhost:3001
